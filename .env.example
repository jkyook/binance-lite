# === Required for futures / wallets ===
BINANCE_API_KEY="YOUR_API_KEY"
BINANCE_API_SECRET="YOUR_API_SECRET"

# Optional: separate sub-account key for hanto/lssec's automated KORU trading
# (requests from INTERNAL_API_TRUSTED_IPS use this instead of the key above,
# so the dashboard/AI insights keep showing the main account). If unset,
# falls back to BINANCE_API_KEY/SECRET above.
BINANCE_API_KEY_KORU=""
BINANCE_API_SECRET_KORU=""

# Source IPs (private VPC IPs) treated as trusted automated callers — no
# login/PIN required. Default matches hanto(c8i_bro)/lssec(c8i).
INTERNAL_API_TRUSTED_IPS="172.31.48.84,172.31.49.221"

# Optional: seed Ban cooldown after restart (ms unix). Prefer file persistence (data/binance_ban_until).
BINANCE_BAN_UNTIL=""

# === AI (optional; at least one for AI features) ===
GEMINI_API_KEY=""
CLAUDE_API_KEY=""
XAI_API_KEY=""
GROK_MODEL="grok-4.7"
AI_PROVIDER="grok"
GEMINI_CHAT_MODEL="gemini-3.8-flash"

# === App ===
PORT=3000
# EC2/public: set 0.0.0.0 (and put Nginx/TLS in front). Local default 127.0.0.1
LISTEN_HOST="127.0.0.1"
APP_URL="http://127.0.0.1:3000"

# Trades sync (heavy REST) — keep false on free-tier to avoid IP bans
VITE_ENABLE_USER_TRADES_SYNC="false"
VITE_ENABLE_EXHAUSTIVE_INCOME_SYNC="false"

# Telegram (optional)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Required to place or cancel futures orders. Unset = all orders rejected.
ORDER_PIN=""

# Solana address for the Jupiter portfolio card (public, read-only). USD, not Binance collateral.
JUPITER_WALLET="8nX7ULNGGapgbYrJzFsgKyPYog8jXtKREcWEMyvSjZG9"
