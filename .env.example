# === Required for futures / wallets ===
BINANCE_API_KEY="YOUR_API_KEY"
BINANCE_API_SECRET="YOUR_API_SECRET"

# Optional: seed Ban cooldown after restart (ms unix). Prefer file persistence (data/binance_ban_until).
BINANCE_BAN_UNTIL=""

# === AI (optional; at least one for AI features) ===
GEMINI_API_KEY=""
CLAUDE_API_KEY=""
XAI_API_KEY=""
GROK_MODEL="grok-4.7"
AI_PROVIDER="grok"
GEMINI_CHAT_MODEL="gemini-3.8-flash"

# === App ===
PORT=3000
# EC2/public: set 0.0.0.0 (and put Nginx/TLS in front). Local default 127.0.0.1
LISTEN_HOST="127.0.0.1"
APP_URL="http://127.0.0.1:3000"

# Trades sync (heavy REST) — keep false on free-tier to avoid IP bans
VITE_ENABLE_USER_TRADES_SYNC="false"
VITE_ENABLE_EXHAUSTIVE_INCOME_SYNC="false"

# Telegram (optional)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Required to place or cancel futures orders. Unset = all orders rejected.
ORDER_PIN=""

# Solana address for the Jupiter portfolio card (public, read-only). USD, not Binance collateral.
JUPITER_WALLET="8nX7ULNGGapgbYrJzFsgKyPYog8jXtKREcWEMyvSjZG9"
